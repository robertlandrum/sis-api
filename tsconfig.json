{
    // Type checks the JavaScript (JSDoc types) - nothing is compiled.
    // Run with `npm run typecheck`.
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["*.js", "routes/**/*.js", "util/**/*.js", "endpoints/**/*.js", "tools/**/*.js",
                "scripts/**/*.js"],
    "exclude": ["node_modules", "test/fixtures/scripts"]
}
